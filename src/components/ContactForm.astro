---
// ContactForm.astro
const { lang = 'en' } = Astro.props;

const i18n = {
  en: {
    title: "Contact",
    name: "Name",
    email: "Email",
    message: "Message",
    send: "Send Message",
    success: "Thank you for your message. We will be in touch shortly.",
    errorName: "Please enter your name.",
    errorEmail: "Please enter a valid email.",
    errorMessage: "Message must be at least 10 characters."
  },
  cs: {
    title: "Kontakt",
    name: "Jméno",
    email: "E-mail",
    message: "Zpráva",
    send: "Odeslat zprávu",
    success: "Děkujeme za vaši zprávu. Brzy se vám ozveme.",
    errorName: "Prosím, zadejte své jméno.",
    errorEmail: "Prosím, zadejte platný e-mail.",
    errorMessage: "Zpráva musí mít alespoň 10 znaků."
  }
};

const t = i18n[lang as keyof typeof i18n] || i18n.en;

let errors = { name: "", email: "", message: "" };
let success = false;

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const name = data.get("name")?.toString() || "";
    const email = data.get("email")?.toString() || "";
    const message = data.get("message")?.toString() || "";

    if (name.length < 2) errors.name = t.errorName;
    if (!email.includes("@")) errors.email = t.errorEmail;
    if (message.length < 10) errors.message = t.errorMessage;

    if (!errors.name && !errors.email && !errors.message) {
      console.log("Form submitted successfully:", { name, email, message });
      success = true;
    }
  } catch (error) {
    console.error(error);
  }
}
---

<div class="max-w-2xl mx-auto py-12 px-8">
  <h2 class="text-3xl font-serif mb-8 text-[#2d3436]">{t.title}</h2>

  {success ? (
    <div class="p-6 bg-green-50 text-green-800 border border-green-200 rounded">
      {t.success}
    </div>
  ) : (
    <form method="POST" class="flex flex-col gap-6">
      <div class="flex flex-col">
        <label class="mb-1 text-sm text-[#4a4a4a]">{t.name}</label>
        <input name="name" class="p-3 border border-[#e0dcd5] focus:ring-1 focus:ring-[#2d3436] outline-none" required />
        {errors.name && <span class="text-red-600 text-xs mt-1">{errors.name}</span>}
      </div>

      <div class="flex flex-col">
        <label class="mb-1 text-sm text-[#4a4a4a]">{t.email}</label>
        <input name="email" type="email" class="p-3 border border-[#e0dcd5] focus:ring-1 focus:ring-[#2d3436] outline-none" required />
        {errors.email && <span class="text-red-600 text-xs mt-1">{errors.email}</span>}
      </div>

      <div class="flex flex-col">
        <label class="mb-1 text-sm text-[#4a4a4a]">{t.message}</label>
        <textarea name="message" rows="5" class="p-3 border border-[#e0dcd5] focus:ring-1 focus:ring-[#2d3436] outline-none" required></textarea>
        {errors.message && <span class="text-red-600 text-xs mt-1">{errors.message}</span>}
      </div>

      <button type="submit" class="bg-[#2d3436] text-white px-8 py-3 rounded-full hover:bg-[#1a1a1a] transition-colors self-start">
        {t.send}
      </button>
    </form>
  )}
</div>
