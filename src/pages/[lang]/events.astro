---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../sanity/client';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'cs' } }];
}

const { lang } = Astro.params;
const suffix = lang === 'cs' ? 'Cs' : 'En';

const events = await client.fetch(`*[_type == "event"] | order(date asc) {
  "slug": slug.current,
  "title": title${suffix},
  "description": description${suffix},
  "image": image.asset->url,
  date,
  location
}`);
---
<Layout>
  <div class="max-w-5xl mx-auto py-16 px-6">
    <h1 class="text-4xl sm:text-5xl font-serif mb-12 text-stone-900 text-center">{lang === 'cs' ? 'Události' : 'Events'}</h1>

    {events.length > 0 ? (
      <div class="space-y-12">
        {events.map((event: any) => (
          <div class="flex flex-col md:flex-row gap-8 items-center bg-[#fdfcf8] border border-[#e0dcd5] p-6 rounded-lg shadow-sm">
            {event.image && (
              <div class="w-full md:w-1/3">
                <a href={`/${lang}/event/${event.slug}`}>
                  <img src={event.image} alt={event.title} class="w-full h-48 object-cover rounded shadow-sm" />
                </a>
              </div>
            )}
            <div class={event.image ? "w-full md:w-2/3" : "w-full"}>
              <div class="flex items-center gap-2 text-sm text-stone-500 mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>{new Date(event.date).toLocaleDateString(lang === 'cs' ? 'cs-CZ' : 'en-US', { dateStyle: 'long' })}</span>
                {event.location && (
                  <>
                    <span>•</span>
                    <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.location)}`} target="_blank" class="flex items-center gap-1 hover:underline underline-offset-2 decoration-stone-300">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                      <span>{event.location}</span>
                    </a>
                  </>
                )}
              </div>
              <h2 class="text-3xl font-serif mb-4 text-stone-900">
                <a href={`/${lang}/event/${event.slug}`} class="hover:underline">{event.title}</a>
              </h2>
              <p class="text-stone-700 font-serif mb-6 line-clamp-3">{event.description}</p>
              <a href={`/${lang}/event/${event.slug}`} class="text-[#2d3436] font-sans font-semibold hover:underline">
                {lang === 'cs' ? 'Více informací →' : 'Learn More →'}
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-stone-600 font-serif italic">
        {lang === 'cs' ? 'Momentálně nejsou naplánovány žádné události.' : 'No events scheduled at the moment.'}
      </div>
    )}
  </div>
</Layout>
